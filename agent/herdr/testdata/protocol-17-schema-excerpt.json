    "amp", "grok", "hermes", "kilo", "qodercli", "maki"
  ],
  "create_flow": ["tab.create", "agent.start"],
  "$defs": {
    "TabCreateParams": {
      "properties": {
        "cwd": {"type": ["string", "null"]},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "focus": {"type": "boolean", "default": false},
        "label": {"type": ["string", "null"]},
        "workspace_id": {"type": ["string", "null"]}
      },
      "type": "object"
    },
    "AgentStartParams": {
      "properties": {
        "args": {"type": "array", "items": {"type": "string"}},
        "kind": {"type": "string"},
        "name": {"type": "string"},
        "pane_id": {"type": "string"},
        "timeout_ms": {"type": ["integer", "null"], "minimum": 0}
      },
      "required": ["name", "kind", "pane_id"],
      "type": "object"
    },
    "AgentPromptParams": {
      "properties": {
        "target": {"type": "string"},
        "text": {"type": "string"},
        "wait": {"type": ["object", "null"]}
      },
      "required": ["target", "text"],
      "type": "object"
    },
    "AgentSendKeysParams": {
      "properties": {
        "keys": {"items": {"type": "string"}, "type": "array"},
        "target": {"type": "string"}
      },
      "required": ["target", "keys"],
      "type": "object"
    }
  }
